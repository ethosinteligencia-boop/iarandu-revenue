{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/inicio", "destination": "/index.html" },
    { "source": "/campanhas", "destination": "/index.html" },
    { "source": "/prospeccao", "destination": "/index.html" },
    { "source": "/equipe", "destination": "/index.html" },
    { "source": "/metas", "destination": "/index.html" },
    { "source": "/ciclo-comercial", "destination": "/index.html" },
    { "source": "/prioridades", "destination": "/index.html" },
    { "source": "/documentacao", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/scene/characters/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/scene/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
